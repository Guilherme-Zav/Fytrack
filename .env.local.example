# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys). Sem isso o app roda em modo demonstração.

# URL BASE do projeto, sem /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...) ou a anon key antiga (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA
# Secret key (sb_secret_...) ou service_role antiga — usada só no servidor, pelo webhook da Cakto
SUPABASE_SECRET_KEY=SUA-CHAVE-SECRETA

# Opcional: URL pública do app (usada para montar a URL do webhook e do script)
# NEXT_PUBLIC_APP_URL=https://fytracker.vercel.app

# Opcional: versão da Graph API do Meta
# META_API_VERSION=v23.0
